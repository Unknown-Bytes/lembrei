generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Survey {
  id                                    String    @id @default(cuid())
  userName                              String?
  dosesAdded                            Boolean   @default(false)
  startedAt                             DateTime  @default(now())
  firstDashboardEntryAt                 DateTime?
  secondDashboardEntryAt                DateTime?
  onboardingCompletedAt                 DateTime?
  firstTimeEnteringDoseCreationArea     DateTime?
  doseCreationCompletedAt               DateTime?
  firstTimeViewingDosesList             DateTime?
  alarmModalAcknowledgedAt              DateTime?
  doses                                 Json?     // Store doses array as JSON
  userEvents                            Json?     // Store user events array as JSON
  createdAt                             DateTime  @default(now())
  updatedAt                             DateTime  @updatedAt
}
